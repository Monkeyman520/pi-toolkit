{
	"name": "pi-quota-keeper",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Coordinated Pi subscription quota visibility and capability-gated activation",
	"engines": {
		"node": ">=22.19.0"
	},
	"packageManager": "npm@11.20.0",
	"files": [
		"extensions",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"smoke": "node tests/pi-smoke.mjs"
	},
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@types/node": "22.19.19",
		"@types/proper-lockfile": "4.1.4",
		"typebox": "1.3.27",
		"typescript": "5.9.3",
		"vitest": "4.1.12"
	},
	"dependencies": {
		"proper-lockfile": "4.1.2"
	}
}
