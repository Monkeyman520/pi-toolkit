{
	"name": "pi-auto-continue",
	"version": "0.1.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"description": "Explicitly armed multi-round continuation, FIFO continuation queue, prompt pipe, and stop hooks for Pi",
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "rolldown -c",
		"build:watch": "rolldown -c --watch",
		"prepack": "bun run build",
		"dev": "pi -e ./extensions/index.ts",
		"start": "pi -e ./dist/index.js",
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"format": "biome check --write .",
		"test": "bun test --isolate",
		"smoke": "node tests/pi-smoke.mjs"
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		],
		"changelogPath": "./dist/CHANGELOG.md"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@earendil-works/pi-tui": "1.5.0",
		"pi-plugin-support": "workspace:*",
		"typebox": "1.3.27"
	}
}
