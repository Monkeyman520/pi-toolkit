{
	"name": "pi-plugin-support",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Instance-owned configuration, discovery and TUI mechanisms for Pi plugins",
	"engines": {
		"node": ">=22.19.0"
	},
	"packageManager": "npm@11.20.0",
	"files": [
		"src",
		"README.md"
	],
	"exports": {
		"./discovery": "./src/discovery.ts",
		"./settings": "./src/settings.ts",
		"./config": "./src/config.ts",
		"./panels": "./src/panels.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"test": "vitest run",
		"pack": "npm pack --ignore-scripts"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@earendil-works/pi-tui": "1.5.0",
		"@types/node": "22.19.19",
		"typebox": "1.3.27",
		"typescript": "5.9.3",
		"vitest": "4.1.12"
	}
}
