{
	"name": "@monkeyman520/pi-prompt-pipeline",
	"version": "0.1.0",
	"license": "MIT",
	"type": "module",
	"description": "Conditional system prompt transformations and one-shot boundary exports for Pi",
	"keywords": [
		"pi-package"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Monkeyman520/pi-toolkit.git",
		"directory": "packages/pi-prompt-pipeline"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"dist",
		"README.md",
		"examples"
	],
	"scripts": {
		"build": "rolldown -c",
		"build:watch": "rolldown -c --watch",
		"prepack": "bun run build",
		"dev": "pi -e ./extensions/index.ts",
		"start": "pi -e ./dist/index.js",
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"format": "biome check --write .",
		"test": "bun test --isolate",
		"smoke": "node tests/pi-smoke.mjs"
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		],
		"changelogPath": "./dist/CHANGELOG.md"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "1.5.2",
		"@earendil-works/pi-coding-agent": "1.5.2",
		"@earendil-works/pi-tui": "1.5.2",
		"typebox": "1.3.27"
	}
}
