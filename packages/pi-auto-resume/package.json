{
	"name": "pi-auto-resume",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Recover interrupted Pi tasks without continuing completed or stopped work",
	"engines": {
		"node": ">=22.19.0"
	},
	"packageManager": "npm@11.20.0",
	"files": [
		"extensions",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"smoke": "node tests/pi-smoke.mjs"
	},
	"pi": {
		"extensions": [
			"./extensions/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@earendil-works/pi-tui": "1.5.0",
		"@types/node": "22.19.19",
		"@biomejs/biome": "2.6.4",
		"typescript": "5.9.3",
		"vitest": "4.1.12",
		"typebox": "1.3.27"
	}
}
