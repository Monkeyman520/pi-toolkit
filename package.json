{
	"name": "pi-packages-workspace",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"node": ">=22.19.0"
	},
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"build": "bun run --workspaces --sequential --if-present build",
		"check": "biome check --error-on-warnings .",
		"check:fix": "biome check --write --error-on-warnings",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit && bun run --workspaces --sequential typecheck",
		"test": "bun test ./tests && bun run --workspaces --sequential test"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.8",
		"@earendil-works/pi-coding-agent": "1.5.2",
		"@types/bun": "1.4.4",
		"@types/node": "22.19.19",
		"rolldown": "1.3.3",
		"typescript": "7.0.2"
	}
}
